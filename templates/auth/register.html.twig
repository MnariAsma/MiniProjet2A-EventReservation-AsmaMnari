{% extends 'base.html.twig' %}

{% block title %}Inscription — Top Events{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="fas fa-user-plus"></i>
        </div>

        <h1>Créer un compte</h1>
        <p class="auth-subtitle">Inscrivez-vous avec une Passkey pour une authentification rapide et sécurisée</p>

        <!-- Status message -->
        <div class="auth-message" id="auth-message">
            <i class="fas fa-info-circle"></i>
            <span id="auth-message-text"></span>
        </div>

        <form id="register-form" onsubmit="handleRegister(event)">
            <div class="auth-form-group">
                <label for="username">Nom d'utilisateur</label>
                <input type="text" id="username" name="username" placeholder="votre_pseudo" required autocomplete="username">
            </div>

            <div class="auth-form-group">
                <label for="email">Adresse email</label>
                <input type="email" id="email" name="email" placeholder="votre@email.com" required autocomplete="email">
            </div>

            <ul class="auth-features">
                <li><i class="fas fa-check-circle"></i> Pas de mot de passe à retenir</li>
                <li><i class="fas fa-check-circle"></i> Authentification biométrique sécurisée</li>
                <li><i class="fas fa-check-circle"></i> Compatible avec tous les appareils modernes</li>
            </ul>

            <button type="submit" class="auth-btn-passkey" id="btn-register">
                <span class="spinner"></span>
                <span class="btn-icon">🔑</span>
                <span class="btn-text">Créer un compte avec Passkey</span>
            </button>
        </form>

        <div class="auth-links">
            <p>Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script>
        async function handleRegister(event) {
            event.preventDefault();

            const btn = document.getElementById('btn-register');
            const msg = document.getElementById('auth-message');
            const msgText = document.getElementById('auth-message-text');
            const email = document.getElementById('email').value.trim();
            const username = document.getElementById('username').value.trim();

            if (!email || !username) {
                msg.classList.add('show', 'error');
                msg.querySelector('i').className = 'fas fa-exclamation-circle';
                msgText.textContent = 'Veuillez remplir tous les champs.';
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;
            msg.classList.remove('show', 'success', 'error');

            try {
                const result = await registerPasskey(email, username);

                msg.classList.add('show', 'success');
                msg.querySelector('i').className = 'fas fa-check-circle';
                msgText.textContent = 'Inscription réussie ! Redirection...';

                setTimeout(() => {
                    window.location.href = '{{ path("home") }}';
                }, 1000);
            } catch (error) {
                msg.classList.add('show', 'error');
                msg.querySelector('i').className = 'fas fa-exclamation-circle';

                if (error.name === 'NotAllowedError') {
                    msgText.textContent = 'Création de Passkey annulée. Veuillez réessayer.';
                } else {
                    msgText.textContent = error.message || 'Erreur lors de l\'inscription. Veuillez réessayer.';
                }

                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }
    </script>
{% endblock %}
