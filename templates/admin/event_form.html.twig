{% extends 'admin/base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} un événement — Admin{% endblock %}
{% block page_title %}{{ is_edit ? 'Modifier l\'événement' : 'Nouvel événement' }}{% endblock %}

{% block body %}

<div class="admin-card">
    <div class="card-header">
        <h3>
            <i class="fas {{ is_edit ? 'fa-edit' : 'fa-plus-circle' }}"></i>
            {{ is_edit ? 'Modifier : ' ~ event.title : 'Créer un événement' }}
        </h3>
        <a href="{{ path('admin_dashboard') }}" class="btn-admin btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    <div class="form-container">
        {{ form_start(form, {'attr': {'class': 'admin-form', 'id': 'event-form'}}) }}

        <div class="form-grid">
            <div class="form-group">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-group">
                {{ form_label(form.location) }}
                {{ form_widget(form.location) }}
                {{ form_errors(form.location) }}
            </div>

            <div class="form-group">
                {{ form_label(form.date) }}
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>

            <div class="form-group">
                {{ form_label(form.seats) }}
                {{ form_widget(form.seats) }}
                {{ form_errors(form.seats) }}
            </div>

            <div class="form-group">
                {{ form_label(form.price) }}
                {{ form_widget(form.price) }}
                {{ form_errors(form.price) }}
            </div>

            <div class="form-group">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>

            <div class="form-group form-full">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin btn-primary" id="submit-event-btn">
                <i class="fas {{ is_edit ? 'fa-save' : 'fa-plus' }}"></i>
                {{ is_edit ? 'Enregistrer' : 'Créer l\'événement' }}
            </button>
            <a href="{{ path('admin_dashboard') }}" class="btn-admin btn-secondary">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
